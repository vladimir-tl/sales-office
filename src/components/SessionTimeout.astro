---
---

<dialog
  id="session-dialog"
  class="sd"
  closedby="none"
  role="alertdialog"
  aria-labelledby="session-title"
  aria-describedby="session-text"
  data-testid="session-dialog"
>
  <h2 id="session-title" class="sd__title" data-testid="session-title">Your session is about to expire</h2>
  <p id="session-text" class="sd__text" data-testid="session-text">Do you want to continue working?</p>
  <div class="sd__actions">
    <button type="button" class="btn btn--secondary btn--sm" id="session-no" data-testid="session-no">No</button>
    <button type="button" class="btn btn--primary btn--sm" id="session-yes" data-testid="session-yes">Yes</button>
  </div>
</dialog>

<script>
  import { writeToken } from '../lib/auth';

  // После минуты бездействия спрашиваем, продолжать ли сессию.
  // Любое действие пользователя (мышь, клавиатура, скролл, тач) перезапускает
  // отсчёт. Таймер обычный setTimeout, поэтому в тестах его можно
  // промотать через Playwright page.clock.
  const SESSION_WARNING_MS = 60_000;

  const dialog = document.getElementById('session-dialog') as HTMLDialogElement;
  let timer: ReturnType<typeof setTimeout> | undefined;
  let closingByChoice = false;

  function schedule() {
    clearTimeout(timer);
    timer = setTimeout(() => {
      if (!dialog.open) dialog.showModal();
    }, SESSION_WARNING_MS);
  }

  function close() {
    closingByChoice = true;
    dialog.close();
  }

  // Закрыть окно можно только кнопками: Esc и клик по фону не работают
  dialog.addEventListener('cancel', (event) => event.preventDefault());
  dialog.addEventListener('close', () => {
    if (closingByChoice) {
      closingByChoice = false;
      return;
    }
    dialog.showModal();
  });

  document.getElementById('session-yes')!.addEventListener('click', () => {
    close();
    schedule();
  });
  document.getElementById('session-no')!.addEventListener('click', () => {
    clearTimeout(timer);
    close();
    writeToken(null);
    location.replace('/');
  });

  // Пока диалог открыт, активность таймер не сбрасывает — ответить надо кнопкой
  const ACTIVITY_EVENTS = ['mousemove', 'mousedown', 'keydown', 'wheel', 'scroll', 'touchstart'];
  for (const type of ACTIVITY_EVENTS) {
    document.addEventListener(type, () => {
      if (!dialog.open) schedule();
    }, { capture: true, passive: true });
  }

  schedule();
</script>

<style>
  .sd {
    width: min(400px, calc(100% - 32px));
    margin: auto;
    padding: 24px;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 24px;
    box-shadow: var(--shadow-lg);
  }
  .sd:focus { outline: none; }
  .sd::backdrop {
    background: rgb(10 12 16 / 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .sd__title { margin: 0 0 8px; font-size: 20px; font-weight: 700; letter-spacing: -0.01em; }
  .sd__text { margin: 0 0 20px; color: var(--text-muted); }
  .sd__actions { display: flex; justify-content: flex-end; gap: 8px; }
</style>
