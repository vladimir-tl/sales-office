---
// Same-origin proxy (src/pages/api/login/auth.ts) forwards to the backend POST /login/student
const endpoint = '/api/login/auth';
---

<div class="login">
  <form
    id="login-form"
    class="login__form"
    novalidate
    data-endpoint={endpoint}
    data-testid="login-form"
  >
    <header class="login__head">
      <h1 data-testid="login-title">Welcome back</h1>
      <p>Log in to your Sales Office account</p>
    </header>

    <div class="field">
      <input
        id="username"
        name="username"
        data-testid="login-username"
        type="text"
        placeholder=" "
        autocomplete="username"
        autocapitalize="none"
        spellcheck="false"
        required
      />
      <label for="username">Username</label>
    </div>

    <div class="field field--password">
      <input
        id="password"
        name="password"
        data-testid="login-password"
        type="password"
        placeholder=" "
        autocomplete="current-password"
        required
      />
      <label for="password">Password</label>
      <button
        type="button"
        class="field__toggle"
        id="toggle-password"
        data-testid="login-password-toggle"
        aria-label="Show password"
        aria-pressed="false"
      >
        <svg class="icon-show" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 5C6.5 5 2.7 9.2 1.5 12c1.2 2.8 5 7 10.5 7s9.3-4.2 10.5-7C21.3 9.2 17.5 5 12 5Zm0 11.5a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9Zm0-2.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" />
        </svg>
        <svg class="icon-hide" viewBox="0 0 24 24" aria-hidden="true">
          <path d="m3.3 2 18.7 18.7-1.3 1.3-3.6-3.6A11.4 11.4 0 0 1 12 19C6.5 19 2.7 14.8 1.5 12c.6-1.4 1.8-3.2 3.5-4.6L2 3.3 3.3 2Zm4.4 6.9A4.5 4.5 0 0 0 15 14.3l-1.9-1.9a2 2 0 0 1-2.5-2.5L7.7 8.9ZM12 5c5.5 0 9.3 4.2 10.5 7a13 13 0 0 1-3.2 4.3l-3-3A4.5 4.5 0 0 0 10.7 7.7L8.6 5.6C9.6 5.2 10.8 5 12 5Z" />
        </svg>
      </button>
    </div>

    <p id="login-error" class="login__error" role="alert" data-testid="login-error" hidden></p>

    <button
      type="submit"
      class="btn btn--primary btn--block"
      id="login-submit"
      data-testid="login-submit"
    >
      <span class="btn__label">Log in</span>
      <span class="spinner" aria-hidden="true"></span>
    </button>
  </form>
</div>

<script>
  import { decodeJwt, validToken, writeToken } from '../lib/auth';

  const DASHBOARD_URL = '/dashboard';

  // Already logged in with a valid token — go straight to the dashboard
  if (validToken()) location.replace(DASHBOARD_URL);

  const form = document.getElementById('login-form') as HTMLFormElement;
  const errorBox = document.getElementById('login-error') as HTMLParagraphElement;
  const submit = document.getElementById('login-submit') as HTMLButtonElement;
  const username = form.elements.namedItem('username') as HTMLInputElement;
  const password = form.elements.namedItem('password') as HTMLInputElement;
  const toggle = document.getElementById('toggle-password') as HTMLButtonElement;
  const endpoint = form.dataset.endpoint!;

  class LoginError extends Error {}

  function showError(message: string) {
    errorBox.textContent = message;
    errorBox.hidden = false;
    form.classList.add('is-invalid');
  }

  function clearError() {
    errorBox.hidden = true;
    form.classList.remove('is-invalid');
  }

  function setLoading(loading: boolean) {
    submit.disabled = loading;
    submit.classList.toggle('is-loading', loading);
    submit.setAttribute('aria-busy', String(loading));
  }

  toggle.addEventListener('click', () => {
    const show = password.type === 'password';
    password.type = show ? 'text' : 'password';
    toggle.setAttribute('aria-pressed', String(show));
    toggle.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
  });

  form.addEventListener('input', clearError);

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearError();

    const user = username.value.trim();
    const pass = password.value;
    if (!user || !pass) {
      showError('Enter your username and password');
      (user ? password : username).focus();
      return;
    }

    setLoading(true);
    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', accept: 'text/plain' },
        body: JSON.stringify({ username: user, password: pass }),
      });

      if (res.status === 401 || res.status === 403) {
        throw new LoginError('Incorrect username or password');
      }
      if (!res.ok) {
        throw new LoginError(
          `Something went wrong on our side (${res.status}). Please try again later.`,
        );
      }

      const token = (await res.text()).trim();
      if (!token || !decodeJwt(token)) throw new LoginError('No token received. Please try again.');

      writeToken(token);
      location.assign(DASHBOARD_URL);
    } catch (err) {
      showError(
        err instanceof LoginError
          ? err.message
          : "Couldn't reach the server. Check your internet connection.",
      );
      setLoading(false);
    }
  });
</script>

<style>
  .login {
    width: 100%;
    max-width: 400px;
  }

  .login__head {
    margin-bottom: 32px;
  }
  .login__head h1 {
    margin: 0 0 8px;
    font-size: clamp(32px, 5vw, 40px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .login__head p {
    margin: 0;
    color: var(--text-muted);
    font-size: 16px;
  }

  .login__form {
    display: grid;
    gap: 12px;
  }
  .login__form[hidden] {
    display: none;
  }

  .field {
    position: relative;
  }
  .field input {
    width: 100%;
    height: 60px;
    padding: 24px 16px 8px;
    font: inherit;
    font-size: 16px;
    color: var(--text);
    background: var(--field);
    border: 2px solid transparent;
    border-radius: 16px;
    outline: none;
    transition:
      border-color 0.15s,
      background 0.15s;
  }
  .field--password input {
    padding-right: 56px;
  }
  .field input:hover {
    background: var(--field-hover);
  }
  .field input:focus {
    border-color: var(--accent);
    background: var(--surface);
  }
  .is-invalid .field input {
    border-color: var(--danger);
  }

  .field label {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    font-size: 16px;
    pointer-events: none;
    transition:
      top 0.15s,
      font-size 0.15s,
      transform 0.15s;
  }
  .field input:focus + label,
  .field input:not(:placeholder-shown) + label {
    top: 10px;
    transform: none;
    font-size: 12px;
  }

  .field__toggle {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }
  .field__toggle:hover {
    color: var(--text);
  }
  .field__toggle:focus-visible {
    outline: 3px solid var(--focus);
  }
  .field__toggle svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }
  .field__toggle .icon-hide,
  .field__toggle[aria-pressed='true'] .icon-show {
    display: none;
  }
  .field__toggle[aria-pressed='true'] .icon-hide {
    display: block;
  }

  .login__error {
    margin: 0;
    padding: 12px 16px;
    font-size: 14px;
    color: var(--danger);
    background: var(--danger-bg);
    border-radius: 12px;
  }
  .login__error[hidden] {
    display: none;
  }

  .login__form .btn--block {
    margin-top: 12px;
  }
</style>
