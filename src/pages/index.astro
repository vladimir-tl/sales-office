---
import Layout from '../layouts/Layout.astro';
import LoginForm from '../components/LoginForm.astro';
---

<Layout title="Log in — Sales Office">
  <div class="page">
    <main class="page__main">
      <a class="brand" href="/" aria-label="Sales Office home" data-testid="brand-link">
        <span class="brand__mark" aria-hidden="true">
          S
        </span>
        <span class="brand__name">Sales Office</span>
      </a>

      <div class="page__form">
        <LoginForm />
      </div>

      <footer class="page__foot" data-testid="footer">
        <span>© {new Date().getFullYear()} Sales Office</span>
        <button
          type="button"
          class="page__foot-link"
          data-cookie-settings
          data-testid="footer-cookie-settings"
        >
          Cookie settings
        </button>
      </footer>
    </main>

    <aside class="page__visual" aria-hidden="true">
      <div class="visual">
        <div class="card card--balance">
          <span class="card__label">Revenue this month</span>
          <span class="card__amount">
            €128,540<span>.00</span>
          </span>
          <span class="card__delta">▲ 12.4% vs last month</span>
          <svg class="card__chart" viewBox="0 0 300 80" preserveAspectRatio="none">
            <path d="M0 62 C30 58 45 40 75 44 S120 66 150 50 195 18 225 26 270 10 300 6" />
          </svg>
        </div>

        <div class="card card--list">
          <div class="row">
            <span class="row__icon">NW</span>
            <span class="row__text">
              <strong>Northwind Ltd</strong>
              <small>Invoice #1042 paid</small>
            </span>
            <span class="row__sum row__sum--in">+ €4,200</span>
          </div>
          <div class="row">
            <span class="row__icon row__icon--alt">BT</span>
            <span class="row__text">
              <strong>Baltic Trade Co.</strong>
              <small>New deal</small>
            </span>
            <span class="row__sum">€12,800</span>
          </div>
          <div class="row">
            <span class="row__icon row__icon--warm">GL</span>
            <span class="row__text">
              <strong>Green Leaf Studio</strong>
              <small>Awaiting payment</small>
            </span>
            <span class="row__sum">€980</span>
          </div>
        </div>

        <p class="visual__caption">Deals, invoices and your sales team — all in one place.</p>
      </div>
    </aside>
  </div>
</Layout>

<style>
  .page {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    min-height: 100dvh;
  }

  .page__main {
    display: flex;
    flex-direction: column;
    padding: 32px clamp(16px, 5vw, 64px);
  }
  .page__form {
    flex: 1;
    display: grid;
    place-items: center;
    padding: 48px 0;
  }
  .page__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    color: var(--text-muted);
    font-size: 13px;
  }
  .page__foot-link {
    padding: 0;
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .page__foot-link:hover {
    color: var(--text);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    align-self: flex-start;
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.02em;
  }
  .brand__mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: var(--primary);
    color: var(--on-primary);
    font-size: 16px;
  }

  /* Right-hand visual panel */
  .page__visual {
    margin: 16px;
    border-radius: 32px;
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 100% 0%, #6a5cff 0%, transparent 55%),
      radial-gradient(90% 80% at 0% 100%, #00b2ff 0%, transparent 60%),
      linear-gradient(160deg, #1736d6 0%, #0a1a5c 100%);
    display: grid;
    place-items: center;
    padding: 48px;
  }

  .visual {
    width: 100%;
    max-width: 420px;
    display: grid;
    gap: 16px;
  }

  .card {
    background: rgb(255 255 255 / 0.12);
    border: 1px solid rgb(255 255 255 / 0.18);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 24px;
    color: #fff;
    padding: 24px;
  }

  .card--balance {
    display: grid;
    gap: 4px;
    transform: rotate(-2deg);
  }
  .card__label {
    font-size: 14px;
    opacity: 0.75;
  }
  .card__amount {
    font-size: 40px;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .card__amount span {
    opacity: 0.6;
    font-size: 28px;
  }
  .card__delta {
    font-size: 13px;
    color: #8dffc5;
  }
  .card__chart {
    width: 100%;
    height: 70px;
    margin-top: 12px;
  }
  .card__chart path {
    fill: none;
    stroke: #fff;
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.9;
  }

  .card--list {
    display: grid;
    gap: 4px;
    padding: 12px;
    margin-left: 32px;
    transform: rotate(1.5deg);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 16px;
  }
  .row + .row {
    border-top: 1px solid rgb(255 255 255 / 0.1);
  }
  .row__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #fff;
    color: #1736d6;
    font-size: 13px;
    font-weight: 700;
  }
  .row__icon--alt {
    background: #8dffc5;
    color: #0a3d2a;
  }
  .row__icon--warm {
    background: #ffd38a;
    color: #5a3800;
  }
  .row__text {
    display: grid;
    flex: 1;
    min-width: 0;
    font-size: 14px;
  }
  .row__text strong {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .row__text small {
    opacity: 0.7;
    font-size: 12px;
  }
  .row__sum {
    font-weight: 600;
    font-size: 14px;
    white-space: nowrap;
  }
  .row__sum--in {
    color: #8dffc5;
  }

  .visual__caption {
    margin: 24px 0 0;
    color: #fff;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  @media (max-width: 900px) {
    .page {
      grid-template-columns: 1fr;
    }
    .page__visual {
      display: none;
    }
    .page__main {
      padding-top: 24px;
    }
    .page__form {
      place-items: start center;
      padding-top: 12vh;
    }
  }
</style>
