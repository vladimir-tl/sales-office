# Backend for login; the same-origin proxy /api/login/auth forwards to $PUBLIC_API_URL/login/student
PUBLIC_API_URL=https://backend.tallinn-learning.ee
# Base URL for GET /sales and /products. Empty = built-in stub at /api that hangs (frontend times out after 10 s).
# PUBLIC_DATA_API_URL=https://backend.tallinn-learning.ee

# Test account for Playwright (real login). Put real values in .env, never here
LOGIN_USER=
LOGIN_PASS=

# Where Playwright runs tests. Set = deployed site, no local dev server. Unset = local `astro dev` on $PORT
BASE_URL=https://sales.tl-academy.ee
