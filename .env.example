# Optional. Backend for login: /api/login/auth forwards to $PUBLIC_API_URL/login/student
# (default https://backend.tallinn-learning.ee). Read at build time
# PUBLIC_API_URL=
# Base URL for GET /sales and /products. Empty = built-in stub at /api that hangs (frontend times out after 10 s).
# PUBLIC_DATA_API_URL=https://backend.tallinn-learning.ee

# Test account for Playwright (real login). Put real values in .env, never here
LOGIN_USER=
LOGIN_PASS=

# Where Playwright runs tests. Set = deployed site. Unset = http://localhost:$PORT (default 4322), start `npx astro dev --port 4322` first
BASE_URL=https://sales.tl-academy.ee
